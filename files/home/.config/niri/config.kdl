// niri 26.04+. setup rewrites /home/bnsplit to the installing user's home.
include "outputs.kdl"
include "appearance.kdl"

input {
    keyboard {
        xkb {
            layout "us"
            variant "altgr-intl"
            options "caps:escape"
        }
        repeat-rate 50
        repeat-delay 250
        numlock
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
    mouse {
        accel-profile "adaptive"
        accel-speed 0.175
    }
    focus-follows-mouse max-scroll-amount="0%"
}

environment {
    PATH "/home/bnsplit/.local/share/bnsplit/scripts:/home/bnsplit/.local/bin:/home/bnsplit/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
    BN_SCRIPTS "/home/bnsplit/.local/share/bnsplit/scripts"
    QT_QPA_PLATFORMTHEME "kde"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    XCURSOR_THEME "Bibata-Modern-Ice"
    XCURSOR_SIZE "24"
    GTK_THEME "bn-adw"
    BROWSER "firefox"
    // Never set GDK_BACKEND globally: it breaks GNOME's screencast portal.
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
    hide-when-typing
}

prefer-no-csd
hotkey-overlay { skip-at-startup; }
screenshot-path "~/Pictures/Screenshots/Screenshot-%Y-%m-%d-%H-%M-%S.png"

// niri-session owns the systemd/D-Bus/portal environment. Do not launch portal
// implementations manually or export an unrelated compositor's desktop name.
spawn-at-startup "awww-daemon"
spawn-at-startup "qs-nothp"
spawn-at-startup "niri-idle"
spawn-at-startup "udiskie"
spawn-at-startup "kdeconnect-indicator"
spawn-at-startup "geary" "--gapplication-service"
spawn-at-startup "qalc" "-exrates" "1+1"
spawn-at-startup "/usr/libexec/gsd-rfkill"
spawn-sh-at-startup "gsettings set org.gnome.desktop.interface gtk-theme bn-adw; gsettings set org.gnome.desktop.interface color-scheme prefer-dark"
spawn-sh-at-startup "wl-paste --type text --watch sh -c 'bnclip store && qs ipc call clipboard reload'"
spawn-sh-at-startup "wl-paste --type image --watch sh -c 'bnclip store && qs ipc call clipboard reload'"
spawn-at-startup "wallwatch"
spawn-at-startup "launch-geoclue"
spawn-at-startup "todoist" "daemon"
spawn-sh-at-startup "tmux set-environment -g NIRI_SOCKET \"$NIRI_SOCKET\"; tmux set-environment -g WAYLAND_DISPLAY \"$WAYLAND_DISPLAY\""

window-rule {
    match app-id="^bnsplit-floating$"
    match title="^(package-install|package-uninstall|quickshell-system-update)$"
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 700; }
}
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}

binds {
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+Ctrl+Return hotkey-overlay-title="Floating terminal" { spawn "kitty" "--class=bnsplit-floating"; }
    Mod+Shift+Return { spawn-sh "kitty \"$BN_SCRIPTS/tmux-main\""; }
    Mod+Space hotkey-overlay-title="Launcher" { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Mod+E { spawn "nautilus" "--new-window"; }
    Mod+Shift+E { spawn "qs" "ipc" "call" "launcher" "launch" "files"; }
    Mod+V { spawn "qs" "ipc" "call" "launcher" "launch" "clipboard"; }
    Mod+K { show-hotkey-overlay; }
    Mod+N { spawn "qs" "ipc" "call" "launcher" "launch" "tasks"; }
    Mod+D { spawn "qs" "ipc" "call" "launcher" "launch" "monitors"; }
    Mod+C { spawn "qs" "ipc" "call" "colorpicker" "hex"; }
    Mod+B { spawn "qs" "ipc" "call" "settings" "toggle" "hideTopBar"; }
    Mod+W { spawn "qs" "ipc" "call" "launcher" "launch" "wallpaper"; }
    Mod+U { spawn "qs" "ipc" "call" "launcher" "launch" "unsplash"; }
    Mod+A { spawn "qs" "ipc" "call" "launcher" "launch" "wallhaven"; }
    Mod+Ctrl+W { spawn "select-wallpaper" "--random"; }
    Mod+Shift+R { spawn "qs" "ipc" "call" "bar" "toggleModule" "resources"; }
    Mod+Shift+P { spawn "qs" "ipc" "call" "bar" "toggleModule" "mprisPlayers"; }
    Mod+Shift+D { spawn "qs" "ipc" "call" "bar" "toggleModule" "dateTime"; }
    Mod+Shift+W { spawn "qs" "ipc" "call" "bar" "toggleModule" "weather"; }
    Mod+Shift+C { spawn "qs" "ipc" "call" "bar" "toggleModule" "controlCenter"; }
    Mod+Shift+B { spawn "qs" "ipc" "call" "bar" "toggleModule" "battery"; }
    Mod+Shift+T { spawn "qs" "ipc" "call" "launcher" "launch" "translate"; }
    Mod+Shift+Q { spawn "qs" "ipc" "call" "launcher" "launch" "processes"; }
    Mod+Period { spawn "qs" "ipc" "call" "launcher" "launch" "emojis"; }
    XF86Calculator { spawn "qs" "ipc" "call" "launcher" "launch" "calculator"; }

    Mod+Q repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }
    Mod+T { toggle-window-floating; }
    Mod+Equal { center-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+S { consume-window-into-column; }
    Mod+Y { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }

    Mod+Alt+H { focus-column-left; }
    Mod+Alt+J { focus-window-down; }
    Mod+Alt+K { focus-window-up; }
    Mod+Alt+L { focus-column-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Alt+Shift+H { set-column-width "-20"; }
    Mod+Alt+Shift+L { set-column-width "+20"; }
    Mod+Alt+Shift+J { set-window-height "+20"; }
    Mod+Alt+Shift+K { set-window-height "-20"; }

    Mod+H { focus-workspace-up; }
    Mod+L { focus-workspace-down; }
    Mod+Grave { focus-workspace-previous; }
    Mod+Shift+H { move-window-to-workspace-up; }
    Mod+Shift+L { move-window-to-workspace-down; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Ctrl+Shift+1 { move-window-to-workspace 1 focus=false; }
    Mod+Ctrl+Shift+2 { move-window-to-workspace 2 focus=false; }
    Mod+Ctrl+Shift+3 { move-window-to-workspace 3 focus=false; }
    Mod+Ctrl+Shift+4 { move-window-to-workspace 4 focus=false; }
    Mod+Ctrl+Shift+5 { move-window-to-workspace 5 focus=false; }
    Mod+Ctrl+Shift+6 { move-window-to-workspace 6 focus=false; }
    Mod+Ctrl+Shift+7 { move-window-to-workspace 7 focus=false; }
    Mod+Ctrl+Shift+8 { move-window-to-workspace 8 focus=false; }
    Mod+Ctrl+Shift+9 { move-window-to-workspace 9 focus=false; }

    Alt+Tab { spawn "qs" "ipc" "call" "alttab" "next"; }
    Alt+Shift+Tab { spawn "qs" "ipc" "call" "alttab" "previous"; }
    Mod+Tab hotkey-overlay-title="niri overview" { toggle-overview; }
    Mod+Delete allow-inhibiting=false hotkey-overlay-title="Lock screen" { spawn "niri-lock"; }
    Mod+Shift+S hotkey-overlay-title="Screenshot selection" { screenshot; }
    Mod+Ctrl+Shift+S hotkey-overlay-title="OCR selection" { spawn "qs" "ipc" "call" "screencapture" "ocr"; }
    Mod+Alt+Shift+S hotkey-overlay-title="Google Lens selection" { spawn "qs" "ipc" "call" "screencapture" "lens"; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Ctrl+Shift+O { spawn "qs" "ipc" "call" "niri" "toggleDPMS"; }
    Mod+Ctrl+Alt+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Ctrl+Shift+E hotkey-overlay-title="Log out" { quit; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "qs ipc call volume increaseVolume 0.05 || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "qs ipc call volume decreaseVolume 0.05 || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "qs ipc call volume toggleVolumeMute || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "qs ipc call volume toggleMicMute || wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "qs ipc call brightness increment 0.05 || brightnessctl s 5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "qs ipc call brightness decrement 0.05 || brightnessctl s 5%-"; }
}
