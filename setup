#!/usr/bin/env bash
set -euo pipefail

if [[ -t 1 && -n ${TERM:-} ]]; then clear; fi

if (($# > 1)); then
  printf 'Usage: ./setup [--skip-libretranslate]\n' >&2
  exit 1
fi

case ${1:-} in
  --help|-h)
    printf 'Usage: ./setup [--skip-libretranslate]\nFedora (DNF5), x86_64 only. Installs niri, the greetd greeter and Quickshell lock screen.\nAutomatically enables errornointernet/quickshell and scottames/awww COPRs, plus RPM Fusion Free and Nonfree.\n'
    exit 0
    ;;
  ''|--skip-libretranslate) ;;
  *) printf 'Unknown option: %s\n' "$1" >&2; exit 1 ;;
esac
skip_libretranslate=${1:-}

dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
files=$dir/files
old_home=/home/bnsplit

stamp=$(date +%Y%m%d-%H%M%S)
backup=$HOME/.local/share/bnsplit-backup/$stamp

# --- output helpers ---
c_blue=$'\e[1;34m' c_green=$'\e[1;32m' c_yellow=$'\e[1;33m' c_red=$'\e[1;31m' c_dim=$'\e[2m' c_off=$'\e[0m'

step() { printf '\n%s==>%s %s%s%s\n' "$c_blue" "$c_off" "$c_green" "$*" "$c_off"; }
info() { printf '    %s%s%s\n' "$c_dim" "$*" "$c_off"; }
warn() { printf '%swarning:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
err() { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; }

copr_repos=(
  errornointernet/quickshell
  scottames/awww
)

dnf_pkgs=(
  niri
  xwayland-satellite
  swayidle
  swaylock
  wlsunset
  playerctl
  qt6-qt5compat
  qt6-qtmultimedia
  qt6-qtimageformats
  awww
  plasma-workspace
  kitty
  cava
  tmux
  fzf
  jq
  curl
  wl-clipboard
  grim
  slurp
  wtype
  tesseract
  tesseract-langpack-eng
  ImageMagick
  ffmpeg-free
  file
  libjxl
  brightnessctl
  ddcutil
  udiskie
  inotify-tools
  python3
  python3-pip
  python3-requests
  python3-watchdog
  python3-pillow
  python3-dbus
  python3-gobject
  python3-opencv
  python3-psutil
  rsync
  gtk3
  gtk4
  gtk-update-icon-cache
  glib2
  dconf
  libnotify
  xdg-utils
  xdg-desktop-portal
  xdg-desktop-portal-gtk
  xdg-desktop-portal-gnome
  gnome-keyring
  NetworkManager
  bluez
  upower
  power-profiles-daemon
  pipewire
  wireplumber
  pipewire-pulseaudio
  pipewire-alsa
  polkit
  procps-ng
  psmisc
  iputils
  util-linux
  zoxide
  fd-find
  vim
  zenity
  libqalculate
  qalculate
  fontconfig
  adwaita-icon-theme
  papirus-icon-theme
  google-noto-sans-fonts
  google-noto-color-emoji-fonts
  google-roboto-fonts
  jetbrains-mono-fonts
  gnome-control-center
  gnome-calendar
  gnome-clocks
  nautilus
  evolution-data-server
  gnome-settings-daemon
  geoclue2
  kde-connect
  geary
  firefox
  policycoreutils
  greetd
  greetd-selinux
  dbus-daemon
  git
)

optional_pkgs=(
  ghostty
  wezterm
  gpu-screen-recorder
  morewaita-icon-theme
  bibata-cursor-themes
  upscayl-ncnn
  python3-pillow-jxl-plugin
)

dnf_pkgs+=(quickshell)

if ((EUID == 0)); then
  err "don't run this as root, sudo is used when needed"
  exit 1
fi

if [[ ! -d $files ]]; then
  err "missing $files; run setup from a complete checkout"
  exit 1
fi

# --- requirements ---
step "Checking requirements"
if [[ ! -r /etc/os-release ]]; then
  err "cannot identify the operating system"
  exit 1
fi
# shellcheck source=/dev/null
source /etc/os-release
if [[ ${ID:-} != fedora ]] || ! command -v dnf5 >/dev/null; then
  err "this installer requires Fedora with DNF5"
  exit 1
fi
if [[ -e /run/ostree-booted ]]; then
  err "Fedora Atomic desktops are not supported; use a mutable Fedora installation"
  exit 1
fi
if [[ $(uname -m) != x86_64 ]]; then
  err "bundled bnclip and bnchroma binaries require x86_64"
  exit 1
fi
command -v sudo >/dev/null || { err "sudo is required"; exit 1; }
info "Fedora ${VERSION_ID:-}, DNF5 found"

step "Requesting sudo"
sudo -v

# --- packages ---
step "Preparing DNF5 COPR support"
if ! dnf5 copr --help >/dev/null 2>&1; then
  sudo dnf5 install -y dnf5-plugins
  if ! dnf5 copr --help >/dev/null 2>&1; then
    err "DNF5 COPR support is unavailable after installing dnf5-plugins"
    exit 1
  fi
fi

step "Enabling required COPR repositories"
warn "COPR packages are community maintained and are not supported by Fedora"
for repo in "${copr_repos[@]}"; do
  info "enabling $repo for this Fedora release"
  if ! sudo dnf5 -y copr enable "$repo"; then
    err "could not enable COPR $repo for Fedora ${VERSION_ID:-}"
    err "check network access and repository support for this release, then retry"
    exit 1
  fi
done

step "Enabling RPM Fusion Free and Nonfree repositories"
warn "RPM Fusion is a third-party repository, separate from Fedora and COPR"
fedora_release=$(rpm -E '%fedora')
if [[ ! $fedora_release =~ ^[0-9]+$ ]]; then
  err "cannot determine Fedora release for RPM Fusion: $fedora_release"
  exit 1
fi
rpmfusion_release_rpms=()
for variant in free nonfree; do
  if ! rpm -q "rpmfusion-$variant-release" >/dev/null 2>&1; then
    rpmfusion_release_rpms+=("https://mirrors.rpmfusion.org/$variant/fedora/rpmfusion-$variant-release-$fedora_release.noarch.rpm")
  fi
done
if ((${#rpmfusion_release_rpms[@]})); then
  if ! sudo dnf5 install -y "${rpmfusion_release_rpms[@]}"; then
    err "could not install RPM Fusion release packages for Fedora $fedora_release"
    exit 1
  fi
fi
# Also re-enable the normal channels when release packages are already installed.
# Do not enable testing/tainted repositories or install codecs/drivers implicitly.
sudo dnf5 config-manager setopt \
  rpmfusion-free.enabled=1 rpmfusion-free-updates.enabled=1 \
  rpmfusion-nonfree.enabled=1 rpmfusion-nonfree-updates.enabled=1

step "Refreshing Fedora repository metadata"
sudo dnf5 makecache --refresh

step "Checking required packages"
available=$(dnf5 -q repoquery --available --queryformat '%{name}\n' "${dnf_pkgs[@]}" "${optional_pkgs[@]}")
missing=()
for pkg in "${dnf_pkgs[@]}"; do
  if ! grep -Fxq -- "$pkg" <<< "$available" && ! rpm -q "$pkg" >/dev/null 2>&1; then
    missing+=("$pkg")
  fi
done
if ((${#missing[@]})); then
  err "required packages unavailable: ${missing[*]}"
  err "check Fedora/COPR/RPM Fusion package availability for this release; see README.md"
  exit 1
fi
for pkg in "${optional_pkgs[@]}"; do
  if grep -Fxq -- "$pkg" <<< "$available" || rpm -q "$pkg" >/dev/null 2>&1; then
    dnf_pkgs+=("$pkg")
  else
    warn "optional package unavailable: $pkg (related feature may need manual installation)"
  fi
done

step "Installing ${#dnf_pkgs[@]} Fedora packages"
sudo dnf5 install "${dnf_pkgs[@]}"

step "Checking session executables"
for cmd in niri niri-session qs awww awww-daemon dbus-run-session; do
  command -v "$cmd" >/dev/null || { err "required command missing after installation: $cmd"; exit 1; }
done
niri_version=$(niri --version)
if [[ ! $niri_version =~ niri[[:space:]]+([0-9]+)\.([0-9]+) ]]; then
  err "cannot determine niri version: $niri_version"
  exit 1
fi
if ((10#${BASH_REMATCH[1]} < 26 || (10#${BASH_REMATCH[1]} == 26 && 10#${BASH_REMATCH[2]} < 4))); then
  err "niri 26.04 or newer is required: $niri_version"
  exit 1
fi
sudo systemd-sysusers /usr/lib/sysusers.d/greetd.conf
getent passwd greetd >/dev/null || { err "Fedora greetd system account is missing"; exit 1; }

# --- stage a copy and rewrite the home path ---
step "Staging config files"
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
cp -a -- "$files/." "$tmp/"

if [[ $(fc-match -f '%{family}' 'Material Symbols Sharp') != *'Material Symbols Sharp'* ]]; then
  step "Downloading Material Symbols Sharp from Google's upstream repository"
  font_dir="$tmp/home/.local/share/fonts/MaterialSymbols"
  mkdir -p -- "$font_dir"
  curl --fail --location --retry 3 \
    'https://raw.githubusercontent.com/google/material-design-icons/master/variablefont/MaterialSymbolsSharp%5BFILL,GRAD,opsz,wght%5D.ttf' \
    --output "$font_dir/MaterialSymbolsSharp.ttf"
  curl --fail --location --retry 3 \
    'https://raw.githubusercontent.com/google/material-design-icons/master/LICENSE' \
    --output "$font_dir/LICENSE"
fi

# Keep unmanaged executables/fonts out of RPM-owned system paths.
mkdir -p -- "$tmp/root/usr/local/bin" "$tmp/root/usr/local/share/fonts"
for binary in bnclip bnchroma; do
  if [[ -f $tmp/root/usr/bin/$binary ]]; then
    mv -- "$tmp/root/usr/bin/$binary" "$tmp/root/usr/local/bin/"
  fi
done
if [[ -d $tmp/root/usr/share/fonts/Outfit ]]; then
  mv -- "$tmp/root/usr/share/fonts/Outfit" "$tmp/root/usr/local/share/fonts/"
fi

step "Checking bundled binary dependencies"
for binary in "$tmp/root/usr/local/bin/bnclip" "$tmp/root/usr/local/bin/bnchroma"; do
  dependencies=$(ldd "$binary" 2>&1) || { err "cannot inspect dependencies of $binary: $dependencies"; exit 1; }
  if [[ $dependencies == *"not found"* ]]; then
    err "$binary has missing Fedora libraries: $dependencies"
    err "rebuild this utility for Fedora before deploying"
    exit 1
  fi
done

if [[ $HOME != "$old_home" ]]; then
  info "rewriting $old_home -> $HOME"
  esc=$(printf '%s' "$HOME" | sed 's/[&|\\]/\\&/g')
  { grep -rIlZF -- "$old_home" "$tmp" || true; } | xargs -0 -r sed -i "s|$old_home|$esc|g"
else
  info "home path already matches, no rewrite needed"
fi

step "Validating niri desktop and greeter configuration"
niri validate --config "$tmp/home/.config/niri/config.kdl"
niri validate --config "$tmp/home/.config/quickshell/greeter/niri.kdl"

step "Staging a system-owned greeter"
greeter_dir="$tmp/root/usr/local/share/bnsplit-greeter"
mkdir -p -- "$greeter_dir"
rsync -rLt --exclude='/store/settings.json' --exclude='/store/data.json' \
  -- "$tmp/home/.config/quickshell/" "$greeter_dir/"
# Never expose personal preferences, API keys, or private wallpaper paths at login.
printf '{}\n' > "$greeter_dir/store/settings.json"
printf '{}\n' > "$greeter_dir/store/data.json"
chmod -R u=rwX,go=rX -- "$greeter_dir"
install -m 0755 -- "$tmp/home/.config/quickshell/greeter/greeter.sh" "$tmp/root/usr/local/bin/bnsplit-greeter"

# User-installed fonts are inaccessible at the login screen. Publish the icon
# font system-wide, just like Outfit, without granting access to a private home.
symbol_dir="$tmp/root/usr/local/share/fonts/MaterialSymbols"
mkdir -p -- "$symbol_dir"
if [[ -f $tmp/home/.local/share/fonts/MaterialSymbols/MaterialSymbolsSharp.ttf ]]; then
  cp -- "$tmp/home/.local/share/fonts/MaterialSymbols/MaterialSymbolsSharp.ttf" "$symbol_dir/"
  cp -- "$tmp/home/.local/share/fonts/MaterialSymbols/LICENSE" "$symbol_dir/"
else
  symbol_font=$(fc-match -f '%{file}' 'Material Symbols Sharp')
  cp -- "$symbol_font" "$symbol_dir/MaterialSymbolsSharp.ttf"
fi

# --- deploy ---
step "Deploying config files"
info "existing files that get overwritten are backed up to:"
info "$backup"
mkdir -p -- "$backup"

if [[ -d $tmp/home ]]; then
  info "copying to $HOME"
  rsync -rLtEOc --no-perms \
    --backup --backup-dir="$backup/home" \
    -- "$tmp/home/" "$HOME/"
fi

if [[ -d $tmp/root ]]; then
  info "copying to / (system files)"
  sudo rsync -rltEOc --no-perms --chown=root:root \
    --backup --backup-dir="$backup/root" \
    -- "$tmp/root/" /
fi

step "Preparing greeter state and lock authentication"
sudo chown -R root:root /usr/local/share/bnsplit-greeter
sudo chmod -R u=rwX,go=rX /usr/local/share/bnsplit-greeter
sudo chown root:root /usr/local/bin/bnsplit-greeter /etc/pam.d/bnsplit-lock
sudo chmod 0755 /usr/local/bin/bnsplit-greeter
sudo chmod 0644 /etc/pam.d/bnsplit-lock
sudo systemd-tmpfiles --create /etc/tmpfiles.d/bn-greetd.conf

# --- root-made backups live in $HOME: hand them back to the user ---
sudo chown -R -- "$(id -u):$(id -g)" "$backup"
find "$backup" -mindepth 1 -type d -empty -delete 2>/dev/null || true

backed_up=0
if [[ -d $backup ]]; then
  backed_up=$(find "$backup" -type f | wc -l)
fi
if ((backed_up == 0)); then
  rmdir -- "$backup" 2>/dev/null || true
fi

step "Restoring SELinux labels for installed system files"
sudo restorecon -RF /usr/local/bin/bnclip /usr/local/bin/bnchroma \
  /usr/local/bin/bnsplit-greeter /usr/local/share/bnsplit-greeter \
  /usr/local/share/fonts/Outfit /usr/local/share/fonts/MaterialSymbols \
  /usr/local/share/xdg-desktop-portal/portals/bnsplit.portal \
  /var/lib/greetd /etc/greetd /etc/tmpfiles.d/bn-greetd.conf /etc/pam.d/bnsplit-lock

step "Refreshing font cache"
sudo fc-cache -f /usr/local/share/fonts
fc-cache -f

# --- libretranslate ---
if [[ $skip_libretranslate != --skip-libretranslate ]]; then
  step "Setting up LibreTranslate virtualenv"
  mkdir -p -- "$HOME/.local/bin"
  python3 -m venv "$HOME/.local/bin/libretranslate_env"
  "$HOME/.local/bin/libretranslate_env/bin/pip" install libretranslate
fi

step "Enabling greetd for the next boot"
# Do not stop an active display manager or terminate the current desktop.
if systemctl is-enabled --quiet display-manager.service 2>/dev/null; then
  current_dm=$(systemctl show --property=Id --value display-manager.service)
  if [[ $current_dm != greetd.service ]]; then
    info "disabling $current_dm for the next boot (current session stays running)"
    sudo systemctl disable "$current_dm"
  fi
fi
sudo systemctl enable --force greetd.service
sudo systemctl set-default graphical.target

# --- summary ---
printf '\n%sAll done !!!%s\n' "$c_green" "$c_off"
if ((backed_up > 0)); then
  printf '%d existing file(s) were backed up to:\n  %s\n' "$backed_up" "$backup"
  printf 'restore with:\n  rsync -a "%s/home/" "%s/"\n  sudo rsync -a "%s/root/" /\n' "$backup" "$HOME" "$backup"
else
  echo "No existing files were overwritten, so no backup was created."
fi

printf '\n%sReboot when ready%s to start the Quickshell greeter, then select niri.\n' "$c_yellow" "$c_off"
info "No display manager was started or stopped in this session."
